# Copia este archivo a .env.local y ajusta los valores. NUNCA comitees .env real.

# Secreto para firmar el JWT de sesion (cookie httpOnly). Usa 32+ bytes aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-secret-change-me-please-32bytes-min

# Wallet del founder (acceso a /admin). Default coincide con el seed demo.
FOUNDER_WALLET=GA7ZELENAFOUNDERDEMOWALLET000000000000000000000000000AAA

# Red Stellar para el anchor-worker (solo testnet en fase Genesis).
STELLAR_NETWORK=testnet

# Secreto de la cuenta de servicio que ancla hashes (SOLO para el worker local).
# Dejalo vacio: el worker lo genera y fondea con friendbot en el primer arranque.
SERVICE_ACCOUNT_SECRET=

# Ruta del archivo SQLite (opcional; default apps/web/data/zelena.db).
# DATABASE_FILE=./data/zelena.db
