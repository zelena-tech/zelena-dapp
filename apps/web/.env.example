# Variables de entorno que lee el código de Zelena. SOLO NOMBRES Y COMENTARIOS: ningún valor.
#
# Uso local: cp apps/web/.env.example apps/web/.env.local, quita el "#" de las que necesites
# y pon tu valor. Todas van comentadas a propósito: una variable vacía no es lo mismo que una
# ausente (p. ej. FOUNDER_WALLET= vacía no toma el valor de desarrollo).
# En Azure van en App Settings de la app (nunca en el repo). Sin ninguna, `npm run dev`
# arranca con SQLite local, secretos de desarrollo y las puertas opcionales apagadas.

# ---------------------------------------------------------------------------
# Sesión y acceso
# ---------------------------------------------------------------------------
# Secreto del JWT de sesión (cookie httpOnly), 32 caracteres o más. Obligatorio en producción.
# Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=
# Llave pública Stellar del founder: cada arranque promueve su fila a `founder` (solo promueve).
# Obligatoria en producción; en desarrollo, sin ella se usa la wallet demo del seed.
# FOUNDER_WALLET=
# Escotilla de arranque del founder: código de un solo uso (16 a 40 caracteres) que da el rol
# founder al entrar con él en /entrar. Tratar como contraseña de root.
# FOUNDER_BOOTSTRAP_CODE=
# =1 siembra las invitaciones demo GENESIS-0001..0006 también en producción (solo para un
# entorno de demostración deliberado).
# SEED_DEMO=
# =1 siembra (y alarga) el código de cohorte ESPECIALIZACION-2026.
# SEED_COHORT=
# Cupos y días de vigencia del código de cohorte (con SEED_COHORT=1). Por defecto 400 y 45.
# COHORT_MAX_USES=
# COHORT_EXPIRES_DAYS=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
# URL pública del sitio (metadatos y el sitio que nombra el mensaje de entrada que se firma).
# Por defecto https://www.zelena.tech.
# SITE_URL=
# Host de los enlaces de los mensajes (Telegram, recordatorios) y del puente local del bot.
# Por defecto https://www.zelena.tech (el bot local: http://localhost:3000).
# ZELENA_APP_URL=
# Nombre legal y correo del responsable de los datos en /privacidad. Sin ellos: "Zelena" y el
# formulario de contacto.
# ZELENA_LEGAL_NAME=
# ZELENA_PRIVACY_EMAIL=
# ID del perfil de Azure Front Door (Front Door → Overview → "Front Door ID"). Con Front Door
# delante es OBLIGATORIA: el límite de intentos solo cree X-Azure-ClientIP si la petición trae
# X-Azure-FDID igual a este ID; sin ella agrupa por la IP del borde. Va junto con la
# restricción de acceso de App Service (docs/DESPLIEGUE-V1.md, A2). Sin Front Door, no hace falta.
# AZURE_FRONT_DOOR_ID=

# ---------------------------------------------------------------------------
# Base de datos (lib/db.ts). Sin nada: SQLite en apps/web/data/zelena.db.
# ---------------------------------------------------------------------------
# Driver explícito: sqlite | libsql | mssql. En producción hoy: sqlite.
# DATABASE_DRIVER=
# Archivo SQLite (en producción, /home/data/zelena.db, fuera de wwwroot).
# DATABASE_FILE=
# libSQL/Turso: URL y token (archivo libSQL local con "file:..." o Turso remoto).
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Azure SQL (no es la base de producción hoy). Con managed identity no hace falta contraseña;
# AZURE_SQL_CLIENT_ID solo si la identidad es asignada por el usuario.
# AZURE_SQL_SERVER=
# AZURE_SQL_DATABASE=
# AZURE_SQL_PORT=
# AZURE_SQL_ENCRYPT=
# AZURE_SQL_CLIENT_ID=
# AZURE_SQL_USER=
# AZURE_SQL_PASSWORD=
# AZURE_SQL_CONNECTION_STRING=
# Ruta del worker del puente síncrono de Azure SQL (por defecto src/lib/db-query.worker.mjs).
# ZELENA_DB_WORKER=

# ---------------------------------------------------------------------------
# Entrar con Microsoft (Entra ID) — pasos en docs/DESPLIEGUE-V1.md, A1
# ---------------------------------------------------------------------------
# =1 enciende la puerta corporativa (apagada por defecto).
# AUTH_ENTRA_ENABLED=
# Application (client) ID, secreto de cliente y Directory (tenant) ID del app registration.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Secreto de NextAuth (32+ bytes aleatorios, distinto de SESSION_SECRET).
# NEXTAUTH_SECRET=
# URL pública de la app, sin barra final (en producción https://www.zelena.tech). Detrás de
# Azure Front Door es obligatoria: con ella se arman la Redirect URI y las redirecciones.
# NEXTAUTH_URL=
# Dominio corporativo aceptado (por defecto zelena.tech).
# ZELENA_CORPORATE_DOMAIN=

# ---------------------------------------------------------------------------
# Asistente de Telegram
# ---------------------------------------------------------------------------
# =1 enciende el bot (apagado por defecto).
# TELEGRAM_ENABLED=
# Token del bot (@BotFather) y secreto del webhook (también en local: el puente de polling lo usa).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Usuario público del bot, solo para el texto de /equipo/telegram.
# TELEGRAM_BOT_USERNAME=
# Opcional: sin ella el bot atiende comandos, no texto libre. Modelo por defecto en config.ts.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BOT_MODEL=

# ---------------------------------------------------------------------------
# Recordatorios de SLA y su cron
# ---------------------------------------------------------------------------
# =1 enciende el motor de recordatorios (apagado por defecto; simular antes con ?simular=1).
# SLA_REMINDERS_ENABLED=
# Secreto del cron (x-cron-secret), 32 caracteres o más; el mismo en los secrets de GitHub.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Ritos
# ---------------------------------------------------------------------------
# Secreto del código rotativo de los ritos (16+). Sin él se deriva de SESSION_SECRET.
# RITES_SECRET=

# ---------------------------------------------------------------------------
# Anclaje en Stellar testnet
# ---------------------------------------------------------------------------
# Secreto de la cuenta de servicio de TESTNET que firma los manageData (nunca de mainnet).
# En local, el worker lo genera si falta (packages/scripts/.service-account.secret).
# SERVICE_ACCOUNT_SECRET=
# Secreto que manda anclaje.yml en x-anchor-secret a /api/anchor/run (32+); el mismo en GitHub.
# ANCHOR_RUN_SECRET=

# ---------------------------------------------------------------------------
# Build y arranque
# ---------------------------------------------------------------------------
# =1 compila en modo standalone (el paquete de Azure; lo pone paquete-azure.yml).
# NEXT_STANDALONE=
# =1 arranca aunque el paquete no pase la verificación (solo emergencias conscientes).
# ZELENA_OMITIR_VERIFICACION=
# Las pone la plataforma, no se configuran a mano: NODE_ENV, NEXT_PHASE, PORT, HOSTNAME, TZ.

# ---------------------------------------------------------------------------
# Solo pruebas (vitest), nunca en producción
# ---------------------------------------------------------------------------
# Listas de nombres privados (separados por comas) para los barridos de nombres; no se versionan.
# ZELENA_NOMBRES_PRIVADOS=
# ZELENA_NOMBRES_VETADOS=
# =1 corre el barrido completo de lo versionado en contenido-publico.test.ts.
# ZELENA_BARRIDO_NOMBRES=
